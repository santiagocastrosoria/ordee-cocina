# =============================================================================
# ORDEE-COCINA — Variables de entorno
# Copiar a .env.local (nunca commitear secretos).
# Usar los mismos valores de Supabase que ordee-mvp.
# =============================================================================

# --- Públicas (expuestas al bundle del navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RESTAURANT_SLUG=demo-ordee

# --- Solo servidor (NUNCA prefijo NEXT_PUBLIC_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESTAURANT_SLUG=demo-ordee

# Opcional: Postgres (migrate:staff-auth / bootstrap:staff-users)
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres
# SUPABASE_DB_PASSWORD=tu_database_password
# NEXT_PUBLIC_APP_URL=https://tu-cocina.vercel.app
# NEXT_PUBLIC_BASE_URL=https://tu-cocina.vercel.app
